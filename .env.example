# ── LLMs (todos opcionales; el coordinator usa el primero disponible) ──
GLM_API_KEY=
GLM_MODEL=glm-4-plus
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
SAMBANOVA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Fallback local universal (sin costo)
OLLAMA_ENABLED=false
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Candidato ──
GMAIL_MY_EMAIL=you@example.com
WHATSAPP_MY_NUMBER=5215500000000
LINKEDIN_PROFILE_URL=https://www.linkedin.com/in/your-profile/
RESUME_FILE=data/resume.json

# ── Google (Gmail + Calendar) — archivos generados con authorize_google.py ──
GMAIL_CREDENTIALS_FILE=config/google_credentials.json
GMAIL_TOKEN_FILE=config/gmail_token.json
CALENDAR_CREDENTIALS_FILE=config/google_credentials.json
CALENDAR_TOKEN_FILE=config/calendar_token.json
CALENDAR_ID=primary

# ── LinkedIn (sesión por cookies; ver modes/anti-ban.md) ──
LINKEDIN_COOKIES_FILE=config/linkedin_cookies.json
LINKEDIN_APPS_PER_HOUR=3

# ── WhatsApp bridge (services/whatsapp) ──
WHATSAPP_BRIDGE_URL=http://localhost:3001

# ── Orchestrator ──
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8777
DB_PATH=data/jobsearcher.db
JOB_MATCH_THRESHOLD=75
JOB_SEARCH_INTERVAL_HOURS=8
EMAIL_CHECK_INTERVAL_MINUTES=30
FOLLOWUP_DAYS=7
LOG_LEVEL=INFO
LOG_DIR=logs
